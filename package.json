{
  "name": "sqlite-server",
  "version": "0.0.1",
  "description": "HTTP + JSON API for SQLite: SQL, key-value, cache, and a job queue for remote clients",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"bench/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/ bench/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:memory": "vitest run --config ./vitest.config.memory.ts --reporter=verbose",
    "test:profile": "vitest run --no-file-parallelism --execArgv=--cpu-prof --execArgv=--cpu-prof-dir=./bench/profiles",
    "bench": "vitest bench --config ./vitest.bench.config.ts --run",
    "bench:compare": "vitest bench --config ./vitest.bench.config.ts --run --compare ./bench/baseline.json",
    "typecheck:bench": "tsc --noEmit -p tsconfig.bench.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@keyv/sqlite": "^6.1.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "jutilities": "^1.0.1",
    "keyv": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite-vec": "^0.1.9",
    "tslib": "^2.9.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
